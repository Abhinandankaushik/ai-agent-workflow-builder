# ---------------------------------------------------------------- nhost
NHOST_SUBDOMAIN=uxoieeqcriebmiuwqser
NHOST_REGION=ap-south-1
HASURA_ADMIN_SECRET=

# Where the Hasura Action / Event Trigger / Cron handlers live.
# Local:  http://localhost:3000        (needs a tunnel for Hasura Cloud to reach it)
# Prod:   https://<your-app>.vercel.app
HANDLER_BASE_URL=http://localhost:3000

# Shared secret Hasura sends as x-action-secret; handlers reject anything else.
ACTION_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------- integrations
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
SLACK_WEBHOOK_URL=

# ---------------------------------------------------------------- seed
SEED_PASSWORD=Password123!
